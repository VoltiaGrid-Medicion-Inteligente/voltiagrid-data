# Copy to airflow/.env (git ignores it) and change every change-me value.
# Generate random values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-to-a-long-random-string
# Optional: encrypts connections and variables stored by Airflow.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# CeleryExecutor broker: the RabbitMQ of voltiagrid-api. Same values as RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS
# in voltiagrid-api/.env.
RABBITMQ_USER=voltia
RABBITMQ_PASSWORD=change-me
# Tasks each worker runs at the same time, and memory of each Spark job. 2 workers x 2 tasks x 1 GB fits in a laptop
# with 16 GB; with 8 GB use AIRFLOW_WORKER_CONCURRENCY=1.
AIRFLOW_WORKER_CONCURRENCY=2
SPARK_DRIVER_MEMORY=1g

# The F4 database of voltiagrid-api, seen from inside the voltia network (host db, port 5432). Same user and
# password as POSTGRES_USER / POSTGRES_PASSWORD in voltiagrid-api/.env.
F4_DATABASE_URL=postgresql+psycopg://voltia:change-me@db:5432/voltiagrid

# Folder that plays the data lake, relative to this folder: the lake/ of voltiagrid-api, where the F3 consumer writes.
LAKE_DIR=../../voltiagrid-api/lake
